venv/
env/

# ---------------------------------------------------------------- artefacts
# Everything under output*/ is regenerated by `python engine.py` /
# `python engine_v2.py` + `python evaluate.py`. Small metric files are tracked
# as review evidence; the bulky, fully reproducible artefacts are not.
**/output*/**/*.pkl
**/output*/**/*.log
**/output*/**/model*.txt
**/output*/plots/
output_ci/
output_v2_ci/
output_smoke/
output_e2e/

# Scored output is keyed by User_id and therefore carries personal data.
# It must never be committed. Glob covers scores.csv, scores_v2.csv, etc.
**/output*/**/scores*.csv
**/*_scores.csv

