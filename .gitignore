# =============================================================================
# Credit Default Risk Model
#
# Two rules in here are not conventions, they are project requirements, and both
# are additionally enforced by a pre-commit hook and a CI step because a
# .gitignore alone has already proven insufficient:
#
#   1. Scored output carries personal data and must never be committed.
#      output_v2/scores_v2.csv was committed once, because the rule at the time
#      said `scores.csv` and the file was named `scores_v2.csv`.
#   2. The dataset is tracked exactly once, at data/credit_risk_data.csv.
#      It previously existed in three places.
#
# Note what is deliberately NOT ignored: the small metric CSVs and JSON under
# output/ and output_v2/. They are the review evidence behind MODEL_REVIEW.md
# and MODEL_CARD.md, they are a few KB each, and they are meant to be diffable.
# Only the bulky, fully regenerable artefacts are excluded.
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets and credentials
# Nothing here should ever exist in this repository. Listed first because it is
# the failure with the worst consequences.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials
credentials.json
service-account*.json
secrets.*
.aws/
.azure/
.gcloud/
*_rsa
*_dsa
*_ed25519


# -----------------------------------------------------------------------------
# Personal data
# Scored output is keyed by User_id. The globs are deliberately wide: any
# suffix, any prefix, anywhere. See DATA.md.
# -----------------------------------------------------------------------------
**/scores*.csv
**/*_scores.csv
**/*scored*.csv
**/predictions*.csv
**/*_pii.*
**/adverse_action*.csv


# -----------------------------------------------------------------------------
# Generated model artefacts
# Regenerated by `python engine.py` / `python engine_v2.py` + `evaluate.py`.
# Matched by file pattern rather than by directory, so the tracked metric files
# beside them stay tracked - a directory exclusion cannot be un-excluded.
# -----------------------------------------------------------------------------
**/output*/**/*.pkl
**/output*/**/*.joblib
**/output*/**/*.log
**/output*/**/model*.txt
**/output*/plots/

# Scratch run directories from smoke tests and CI
output_ci/
output_v2_ci/
output_smoke/
output_e2e/
output_chk/
output_yaml_chk/
output_*_tmp/
runs/


# -----------------------------------------------------------------------------
# Data
#
# The full 22.8 MB dataset is NOT distributed here - it was 79% of the
# repository and its licence is unknown. A stratified sample is committed
# instead: data/credit_risk_data_sample.csv, ~1.8 MB, built by
# analysis/make_sample.py and checked for fidelity against the full file.
#
# Tests and CI run against whichever is present. See docs/DATA.md.
# -----------------------------------------------------------------------------
data/credit_risk_data.csv
!data/credit_risk_data_sample.csv

# Bulk formats that should never be committed, so a large intermediate cannot
# slip in unnoticed.
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3
data/raw/
data/interim/
data/external/
data/*/


# -----------------------------------------------------------------------------
# Experiment tracking and ML tooling
# Not in use yet; listed so adopting any of them cannot pollute the repository.
# -----------------------------------------------------------------------------
mlruns/
mlartifacts/
.mlflow/
wandb/
.optuna/
optuna.db
lightning_logs/
catboost_info/
.neptune/
ray_results/
.dvc/cache
checkpoints/


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt


# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version
.conda/
conda-meta/


# -----------------------------------------------------------------------------
# Testing, coverage and type checking
# -----------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
nosetests.xml
junit*.xml
report.html


# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
*-checkpoint.ipynb


# -----------------------------------------------------------------------------
# Scratch and temporary files
# run_test.yaml was staged accidentally once; these patterns cover that class
# of file so it cannot happen silently.
# -----------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*~
run_test.*
test_output.*
scratch_*.py
tmp_*.py
debug_*.py

# archive/ holds the sources exactly as delivered - the "before" state the
# review is written against. Nothing in it is a stray backup file, so it is
# re-included explicitly: `*.orig` and friends above would otherwise shadow
# archive/original/model.ipynb.original on a fresh clone.
!archive/
!archive/**


# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
.vs/
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo


# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
